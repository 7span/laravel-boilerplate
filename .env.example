APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONT_WEBSITE_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public base URL of the bucket, set it when the files are served through a CDN.
AWS_URL=
# AWS_ENDPOINT=
# Delete the non-synced or temp files from the disks after this many days.
TEMP_FILE_DELETE_AFTER_DAYS=2

CDN_ENABLE=false
CDN_URL=

VITE_APP_NAME="${APP_NAME}"

DEVELOPER_USERNAME=dev@7span.com
DEVELOPER_PASSWORD=dev@7span

# Developer tooling, every dashboard below sits behind the "developer" middleware.
TELESCOPE_ENABLED=true
TELESCOPE_PATH=developer/telescope

HORIZON_PATH=developer/horizon
# HORIZON_DOMAIN=

LOG_VIEWER_ENABLED=true

API_VERSION=0.0.1

MASTER_PASSWORD=
MASTER_OTP=

# Passport signs tokens with storage/oauth-*.key by default, run `php artisan passport:keys`.
# Set these two instead when the keys have to come from the environment.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# PASSPORT_CONNECTION=

NOTIFICATION_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ADMIN_APP_ID=
ONESIGNAL_ADMIN_API_KEY=

SOFT_DELETE_RETENTION_DAYS=90
